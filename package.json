{
  "name": "realworld",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "nodemon --exec \"node --enable-source-maps --import @backtickjs/node-plugin src/index.tsx\"",
    "serve": "node --enable-source-maps --import @backtickjs/node-plugin src/index.tsx",
    "typecheck": "backtick-tsc --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "e2e": "playwright test",
    "generate:api": "npx -y openapi-typescript@7.13.0 realworld/specs/api/openapi.yml --root-types --root-types-no-schema-prefix -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@backtickjs/bundler": "0.5.2",
    "@backtickjs/core": "0.5.2",
    "@backtickjs/jsx-solid": "0.5.2",
    "@backtickjs/node-plugin": "0.5.2",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "marked": "16.4.1",
    "openapi-fetch": "0.17.0",
    "sanitize-html": "2.17.0",
    "solid-js": "1.9.17",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "0.5.2",
    "@backtickjs/tsc": "0.5.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^25.9.1",
    "@types/sanitize-html": "2.16.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,tsx"
  },
  "backtick": {
    "plugins": [
      "@backtickjs/jsx-solid/plugin"
    ]
  }
}
